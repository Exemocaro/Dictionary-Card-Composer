{
  "manifest_version": 3,
  "name": "Dictionary Card Composer",
  "version": "0.1.0",
  "description": "Make Anki cards from Oxford, Cambridge, Merriam-Webster, Priberam and Infopédia entries in one click, or compose them in detail.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Dictionary Card Composer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "https://www.oxfordlearnersdictionaries.com/*",
    "https://dictionary.cambridge.org/*",
    "https://www.merriam-webster.com/*",
    "https://dicionario.priberam.org/*",
    "https://www.infopedia.pt/*"
  ]
}
